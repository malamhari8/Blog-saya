---
import "../styles/global.css";
const { frontmatter } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>{frontmatter?.title ?? "Blog Saya"}</title>
  </head>
  <body>
    <header class="site-header">
      <span class="brand">samudra</span>
      <nav class="navbar">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <div class="container">
      {frontmatter?.title && <h1>{frontmatter.title}</h1>}
      <slot />
    </div>
  </body>
</html>
